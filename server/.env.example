# 复制为 .env 后填写
# 用户资料不在本库：表里只存 UniSSO 的 users.id（= OAuth sub，36 字符）
PORT=8080

# MySQL（YatTerra 平台按组名注入；本地开发填自己的实例）
MYSQL_HOST=mysql.platform-infra.svc.cluster.local
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=

# UniSSO（在 https://sso.ssemarket.cn/developer 注册应用后填写）
SSO_ISSUER=https://sso.ssemarket.cn
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# 留空则按请求 Host 推导：<proto>://<host>/api/auth/callback
SSO_REDIRECT_URI=
SSO_SCOPE=openid profile:username profile:name profile:avatar email sse_identity
# 资格校验缓存秒数：0 = 每次请求都查 userinfo
SSO_DEVELOPER_TTL_SECONDS=60
# 用户目录（users/list）缓存秒数：0 = 不缓存，每次都拉全量
SSO_DIRECTORY_TTL_SECONDS=60
# 资格写入超时（毫秒）
SSO_WRITE_TIMEOUT_MS=5000
# 待同步资格的重试轮询间隔（毫秒），<=0 关闭后台任务
QUAL_SYNC_INTERVAL_MS=15000
# 资格写入复用 SSO_CLIENT_ID / SSO_CLIENT_SECRET；平台侧需把本应用加入
# UNISSO_DEVELOPER_WRITE_CLIENTS，并确认 m2m_enabled=true

# 开发期身份模拟：1 强制开启，0 强制关闭，留空则仅未配置 SSO 时开启
DEV_LOGIN=

# 会话 cookie 签名密钥（生产必须固定，否则重启后会话 cookie 失效）
SESSION_SECRET=
SESSION_DAYS=30

# join 平台服务端调用本平台时的共享密钥（Authorization: Bearer <key> 或 X-Api-Key）
# 留空则 /api/join/* 一律返回 503
JOIN_API_KEY=
