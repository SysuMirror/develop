{
  "name": "developer-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Developer 平台后端（Express + MySQL + UniSSO OAuth2）",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/schema.sql dist/schema.sql",
    "start": "node dist/index.js",
    "dev": "node --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "node src/migrate.ts",
    "seed": "SEED=1 node src/migrate.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
